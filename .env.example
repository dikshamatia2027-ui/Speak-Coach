# ==============================================================================
# SpeakCoach Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Dodo Payments (Merchant of Record & Subscriptions)
# Get your credentials at: https://app.dodopayments.com
# ------------------------------------------------------------------------------

# Your Dodo Payments Secret API Key (test_... or live_...)
DODO_PAYMENTS_API_KEY=test_your_api_key_here

# Product ID for the Pro Subscription tier ($12/mo)
DODO_PAYMENTS_PRODUCT_ID=pdt_your_product_id_here

# Webhook signing secret for /api/webhooks/dodo
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_webhook_secret_here

# Environment mode: 'test_mode' for sandbox or 'live_mode' for production
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Optional: Your Dodo Payments Business ID for direct Customer Portal links
DODO_PAYMENTS_BUSINESS_ID=your_business_id_here

# ------------------------------------------------------------------------------
# REQUIRED for AI features (speech-to-text, practice analysis, vocabulary feedback)
# Get a free key at https://console.groq.com/keys
# Local dev: copy this file to .env and paste the key below.
# Production: set GROQ_API_KEY as an environment variable in Vercel
# (Project -> Settings -> Environment Variables), then redeploy.
# Server-side only - never prefix it with VITE_.
# ------------------------------------------------------------------------------
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# Accounts, saved history and the server-held Pro plan (Supabase)
# Supabase dashboard -> Project Settings -> API
# VITE_ variables are public by design. SUPABASE_SERVICE_ROLE_KEY is a SECRET:
# server-side only, set it in Vercel as Sensitive, never commit it.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

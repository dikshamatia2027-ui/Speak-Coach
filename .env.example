# ==============================================================================
# SpeakCoach Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Dodo Payments (Merchant of Record & Subscriptions)
# Get your credentials at: https://app.dodopayments.com
# ------------------------------------------------------------------------------

# Your Dodo Payments Secret API Key (test_... or live_...)
DODO_PAYMENTS_API_KEY=test_your_api_key_here

# Product ID for the Pro Subscription tier ($12/mo)
DODO_PAYMENTS_PRODUCT_ID=pdt_your_product_id_here

# Webhook signing secret for /api/webhooks/dodo
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_webhook_secret_here

# Environment mode: 'test_mode' for sandbox or 'live_mode' for production
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Optional: Your Dodo Payments Business ID for direct Customer Portal links
DODO_PAYMENTS_BUSINESS_ID=your_business_id_here

# ------------------------------------------------------------------------------
# REQUIRED for AI features — transcription, practice analysis and vocabulary
# sentence feedback. Without it the app honestly returns "AI is not configured."
# (no mock data). Get a FREE key at https://aistudio.google.com/apikey —
# usage tier "Free" needs no billing; per-model rate limits are shown in AI Studio.
# Local dev: copy this file to .env and paste the key below, then restart.
# Cloudflare preview (wrangler dev): put it in a .dev.vars file instead.
# Production (Vercel): Project → Settings → Environment Variables →
# add GEMINI_API_KEY for Production + Preview, then redeploy.
# Server-side only — read in src/routes/api/analyze.ts, never sent to browsers.
# Google Gemini models: gemini-3.5-transcribe (verbatim speech-to-text, keeps
# filler words) + gemini-3.8-flash (coaching analysis & vocabulary feedback).
# ------------------------------------------------------------------------------
GROQ_API_KEY=
